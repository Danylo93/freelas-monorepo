{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",            // ou "NodeNext"
    "moduleResolution": "Bundler", // ou "NodeNext"
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
